{
    "name": "aadi/marketing-os",
    "type": "project",
    "description": "Aadi Marketing OS unified Laravel application for four owned brands",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {"psr-4":{"App\\":"app/","Database\\Factories\\":"database/factories/","Database\\Seeders\\":"database/seeders/"}},
    "autoload-dev": {"psr-4":{"Tests\\":"tests/"}},
    "scripts": {
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
        "post-update-cmd": ["@php artisan vendor:publish --tag=laravel-assets --ansi --force"],
                "test": "@php artisan test",
        "deploy": "@php scripts/deploy.php"
    },
    "extra": {"laravel":{"dont-discover":[]}},
    "config": {"optimize-autoloader":true,"preferred-install":"dist","sort-packages":true,"allow-plugins":{"php-http/discovery":true}},
    "minimum-stability":"stable",
    "prefer-stable":true
}
